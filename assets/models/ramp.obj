v -2.00000 1.70000 -4.00000
v 2.00000 0.00000 4.00000
v 2.00000 0.00000 -4.00000
v -2.00000 0.00000 -4.00000
vn 0.00000 0.97816 0.20786
vn -0.00000 0.97816 0.20786
vn 0.00000 0.00000 -1.00000
vn 0.00000 0.00000 -1.00000
vn -1.00000 0.00000 0.00000
vn 1.00000 0.00000 0.00000
vn 0.00000 -1.00000 0.00000
vn 0.00000 -1.00000 0.00000
usemtl ramp
f 1//1 2//1 3//1
f 1//2 4//2 2//2
f 5//3 3//3 2//3
f 5//4 6//4 3//4
f 1//5 3//5 6//5
